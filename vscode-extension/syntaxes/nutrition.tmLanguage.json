{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Nutrition",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#import-directive"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#quantities"
    },
    {
      "include": "#property-assignment"
    },
    {
      "include": "#number-with-unit"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#booleans"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.nutrition",
          "match": "//.*$"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "keyword.declaration.nutrition",
          "match": "@(unit|property|ingredient|food|recipe|exercise|day|ate|exercised)\\b"
        }
      ]
    },
    "import-directive": {
      "patterns": [
        {
          "name": "meta.import.nutrition",
          "match": "^(\\s*)(!import)\\s+(\"(?:[^\"\\\\]|\\\\.)*\")\\s*(?://.*)?$",
          "captures": {
            "2": {
              "name": "keyword.control.import.nutrition"
            },
            "3": {
              "name": "string.quoted.double.nutrition"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.other.type.nutrition",
          "match": "\\b(Int|Float|Bool)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.nutrition",
          "match": "\"(?:[^\"\\\\]|\\\\.)*\""
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.nutrition",
          "match": "\\d+\\.\\d+|\\d+\\.|\\.\\d+"
        },
        {
          "name": "constant.numeric.integer.nutrition",
          "match": "\\d+"
        }
      ]
    },
    "booleans": {
      "patterns": [
        {
          "name": "constant.language.boolean.nutrition",
          "match": "\\b(true|false|True|False)\\b"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.bracket.round.nutrition",
          "match": "[\\(\\)]"
        },
        {
          "name": "punctuation.bracket.curly.nutrition",
          "match": "[\\{\\}]"
        },
        {
          "name": "punctuation.bracket.square.nutrition",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.separator.nutrition",
          "match": "[,:]"
        },
        {
          "name": "punctuation.operator.assignment.nutrition",
          "match": "="
        }
      ]
    },
    "quantities": {
      "patterns": [
        {
          "name": "meta.quantity.nutrition",
          "begin": "\\(",
          "end": "\\)",
          "patterns": [
            {
              "include": "#numbers"
            },
            {
              "name": "keyword.other.unit.nutrition",
              "match": "[A-Za-z_][A-Za-z0-9_\\-]*"
            }
          ]
        }
      ]
    },
    "property-assignment": {
      "patterns": [
        {
          "name": "support.type.property-name.nutrition",
          "match": "[A-Za-z_][A-Za-z0-9_\\-]*(?=\\s*:)"
        }
      ]
    },
    "number-with-unit": {
      "patterns": [
        {
          "match": "(\\d+(?:\\.\\d+)?|\\.\\d+)([A-Za-z_][A-Za-z0-9_\\-]*)",
          "captures": {
            "1": {
              "name": "constant.numeric.nutrition"
            },
            "2": {
              "name": "keyword.other.unit.nutrition"
            }
          }
        }
      ]
    }
  },
  "scopeName": "source.nutrition"
}
