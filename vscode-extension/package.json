{
  "name": "nutrition-language",
  "displayName": "Nutrition Language Support",
  "description": "Language support for Nutrition files",
  "version": "0.1.0",
  "publisher": "nutrition",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:nutrition"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "nutrition.findIngredient",
        "title": "Nutrition: Find Ingredient"
      },
      {
        "command": "nutrition.findFood",
        "title": "Nutrition: Find Food"
      },
      {
        "command": "nutrition.findRecipe",
        "title": "Nutrition: Find Recipe"
      },
      {
        "command": "nutrition.findDay",
        "title": "Nutrition: Find Day"
      },
      {
        "command": "nutrition.today",
        "title": "Nutrition: Today"
      }
    ],
    "languages": [
      {
        "id": "nutrition",
        "aliases": [
          "Nutrition",
          "nutrition"
        ],
        "extensions": [
          ".nutrition"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "nutrition",
        "scopeName": "source.nutrition",
        "path": "./syntaxes/nutrition.tmLanguage.json"
      }
    ],
    "documentFormatters": [
      {
        "language": "nutrition",
        "scheme": "file"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^2.22.0",
    "typescript": "^5.3.0"
  }
}
